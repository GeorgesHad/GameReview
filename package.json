{
  "name": "football-match-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "vite build",
    "start": "wrangler dev --local",
    "dev": "npm run build && npm run start --",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:deploy": "wrangler deploy --dry-run --env dev --outdir .wrangler/dry-run/dev && wrangler deploy --dry-run --env prod --outdir .wrangler/dry-run/prod"
  },
  "dependencies": {
    "hono": "4.13.23",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.16.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "wrangler": "4.169.0"
  }
}
